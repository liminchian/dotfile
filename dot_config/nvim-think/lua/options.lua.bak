-- 位置：~/.config/nvim-think/lua/options.lua

require "nvchad.options"

local o = vim.opt

o.cmdheight = 0          -- 底部不留 cmdline，交給 noice 的浮動視窗
o.scrolloff = 8
o.sidescrolloff = 8
o.cursorline = true
o.relativenumber = true
o.wrap = false
o.signcolumn = "yes"
o.fillchars = { eob = " " } -- 檔尾不顯示 ~

-- Zed 風格的 inlay hints
vim.lsp.inlay_hint.enable(true)
