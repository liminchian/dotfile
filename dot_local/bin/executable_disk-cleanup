#!/usr/bin/env python3
"""disk-cleanup — 硬碟用量達門檻時，讓本地 laya 判斷 $HOME 裡哪些檔案系列該刪，寫進 Google Tasks。

系列 = $HOME 下前 3 層的同一個目錄。每個系列取最大的檔案當代表，
把路徑、metadata、前後 20 行送給 laya-serve 分類成 delete / review / keep。

用法：disk-cleanup            用量 < 80% 直接結束
      disk-cleanup --force    不管用量都跑
      disk-cleanup --dry-run  只印結果，不寫 Google Tasks
"""
import json, os, shutil, sys, time, urllib.parse, urllib.request
from collections import defaultdict
from pathlib import Path

THRESHOLD = 80
LAYA = "http://localhost:8001/v1/systemone/batch"
MIN_FILE = 1 << 20      # 小於 1 MiB 的檔案不算
TOP_SERIES = 30
GTASKS = Path.home() / ".config/gtasks"

QUESTIONS = {"act": {
    "type": "choice",
    "instructions": "The disk is almost full. Should this series of files be removed to free space?",
    "criteria": {
        "delete": "safe to delete: regenerable cache, build artifact, log, temp file, old download or duplicate",
        "review": "possibly removable: large or long untouched, but the user should check first",
        "keep": "important: personal documents, photos, source code, config, keys or app data",
    },
}}


def human(n):
    for unit in "BKMGT":
        if n < 1024:
            return f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}P"


def scan(home):
    series = defaultdict(lambda: {"size": 0, "files": []})
    for root, dirs, files in os.walk(home, onerror=lambda e: None):
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]
        rel = Path(root).relative_to(home)
        group = Path(*rel.parts[:3]) if rel.parts else Path(".")
        for f in files:
            p = os.path.join(root, f)
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if st.st_size < MIN_FILE or not os.path.isfile(p) or os.path.islink(p):
                continue
            s = series[str(group)]
            s["size"] += st.st_size
            s["files"].append((st.st_size, p, st))
    return sorted(series.items(), key=lambda kv: -kv[1]["size"])[:TOP_SERIES]


def head_tail(path, n=20):
    try:
        with open(path, "rb") as fh:
            if b"\0" in fh.read(4096):
                return "(binary)"
            fh.seek(0)
            lines = fh.read(4 << 20).decode("utf-8", "replace").splitlines()
    except OSError:
        return "(unreadable)"
    cut = lambda ls: "\n".join(l[:200] for l in ls)
    if len(lines) <= 2 * n:
        return cut(lines)
    return cut(lines[:n]) + "\n...\n" + cut(lines[-n:])


def describe(home, key, s):
    group, now = key, time.time()
    s["files"].sort(key=lambda t: -t[0])
    size, rep, st = s["files"][0]
    newest = max(t[2].st_mtime for t in s["files"])
    last_access = max(t[2].st_atime for t in s["files"])
    return "\n".join([
        f"series: ~/{group}/**",
        "extensions: " + ", ".join(sorted({Path(t[1]).suffix.lower() or "(none)" for t in s["files"]})[:15]),
        f"files: {len(s['files'])}, total size: {human(s['size'])}",
        f"newest modification: {(now - newest) / 86400:.0f} days ago",
        f"last access: {(now - last_access) / 86400:.0f} days ago",
        f"largest file: {rep.replace(str(home), '~')} ({human(size)}, mode {oct(st.st_mode & 0o777)})",
        "content (first/last 20 lines of largest file):",
        head_tail(rep),
    ])[:20000]


def post(url, data, headers=None):
    req = urllib.request.Request(url, data, headers or {})
    with urllib.request.urlopen(req, timeout=300) as r:
        return json.load(r)


def gtasks_token():
    tok = json.loads((GTASKS / "token.json").read_text())[0]["token"]
    app = json.loads((GTASKS / "credentials.json").read_text())["installed"]
    body = urllib.parse.urlencode({
        "client_id": app["client_id"], "client_secret": app["client_secret"],
        "refresh_token": tok["refresh_token"], "grant_type": "refresh_token",
    }).encode()
    return post(app["token_uri"], body)["access_token"]


def main():
    home = Path.home()
    used = shutil.disk_usage(home)
    pct = used.used * 100 // (used.used + used.free)  # 同 df：不含 root 保留區
    if pct < THRESHOLD and "--force" not in sys.argv:
        print(f"磁碟用量 {pct}% < {THRESHOLD}%，不需清理")
        return

    series = scan(home)
    states = [describe(home, k, s) for k, s in series]
    results = post(LAYA, json.dumps({"states": states, "questions": QUESTIONS}).encode(),
                   {"Content-Type": "application/json"})["results"]

    picks = []
    for (key, s), state, res in zip(series, states, results):
        a = res["answers"]["act"]
        print(f"{a['choice']:6} {a['answer_confidence']:.2f} {human(s['size']):>7}  ~/{key}")
        if a["choice"] != "keep":
            picks.append((key, s, a))

    if "--dry-run" in sys.argv or not picks:
        return
    auth = {"Authorization": f"Bearer {gtasks_token()}", "Content-Type": "application/json"}
    label = {"delete": "刪除", "review": "檢查"}
    for group, s, a in picks:
        samples = "\n".join(p.replace(str(home), "~") for _, p, _ in s["files"][:5])
        task = {
            "title": f"[{label[a['choice']]}] ~/{group}  {human(s['size'])}",
            "notes": f"磁碟 {pct}%｜laya 信心 {a['answer_confidence']:.2f}｜{len(s['files'])} 個檔案\n{samples}",
        }
        post("https://tasks.googleapis.com/tasks/v1/lists/@default/tasks", json.dumps(task).encode(), auth)
    print(f"已寫入 {len(picks)} 筆 Google Tasks")


if __name__ == "__main__":
    main()
