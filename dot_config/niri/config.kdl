input {
    keyboard {
        xkb {
            // You can set rules, model, layout, variant and options.
            // For more information, see xkeyboard-config(7).

            // For example:
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"
        }

        repeat-delay 200
        repeat-rate 30
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    touchpad {
        tap
        // dwt
        // dwtp
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
    }

    mouse {
        // natural-scroll
        accel-speed -0.5
        accel-profile "flat"
    }

    // warp-mouse-to-focus

    // 新版可加 max-scroll-amount 限制：只有「已經完全在畫面內」的視窗/輸出
    // 才會因為滑鼠移入而搶焦點，避免捲動列表時不小心切走焦點。
    focus-follows-mouse max-scroll-amount="0%"
}

output "DP-1" {
    mode "1920x1080@143.912"
    variable-refresh-rate on-demand=true
    scale 1.00
    transform "normal"
    position x=0 y=0
}

layout {
    center-focused-column "on-overflow"

    // You can customize the widths that "switch-preset-column-width" (Mod+R) toggles between.
    preset-column-widths {
        // Proportion sets the width as a fraction of the output width, taking gaps into account.
        // For example, you can perfectly fit four windows sized "proportion 0.25" on an output.
        // The default preset widths are 1/3, 1/2 and 2/3 of the output.
        proportion 0.33333
        proportion 0.5
        proportion 0.66667

        // Fixed sets the width in logical pixels exactly.
        // fixed 1920
    }

    // You can change the default width of the new windows.
    default-column-width { proportion 0.4; }
    // If you leave the brackets empty, the windows themselves will decide their initial width.
    // default-column-width {}

    // 🎨 設計優化：原本是 teal 色系，跟你的黑白網點桌布/waybar 衝突，
    // 改成無色彩的灰階，就算之後打開 focus-ring 也不會破壞整體調性。
    focus-ring {
        off

        width 2
        active-color "#F2F2F2"
        inactive-color "#3A3A3A"
        // active-gradient from="#0082c8" to="#26D0CE" angle=45
        // inactive-gradient from="#505050" to="#808080" angle=45
    }

    border {
        // off

        width 2
        active-color "#FFFFFF"
        // 🎨 設計優化：原本 #333448 帶一點藍紫偏色，跟純黑白桌布不搭。
        // 改成真正中性的灰（R=G=B），在無色彩環境裡才不會顯得突兀。
        inactive-color "#3A3A3A"
        // 🎨 設計優化：整體改成無色彩系統之後，這個紅色反而更醒目、更有效——
        // 「單一保留色」是常見手法：畫面 99% 是黑白，唯一有彩度的地方就是
        // 真正需要你注意的警示狀態，眼睛會自動被吸過去，不需要更花俏的顏色。
        urgent-color "#FF453A"
    }

    // 🎨 設計優化：這區塊原本沒設，代表用 niri 預設的暖橘 #ffc87f，
    // 跟黑白桌布衝突。改成半透明白，插入預覽時會像是桌布上的白色網點
    // 「亮」了一下，視覺上直接跟桌布的圖案語言呼應。
    insert-hint {
        color "#FFFFFF66"
    }

    // 🆕 立體感陰影。draw-behind-window 關閉時陰影只畫在視窗周圍，
    // 若你有設 geometry-corner-radius + clip-to-geometry（你已經有了），
    // niri 會知道圓角半徑，陰影邊緣才不會在圓角處露出方形瑕疵。
    shadow {
        on
        // 模糊程度，越大越柔和
        softness 30
        // 陰影往外擴張的範圍
        spread 5
        // 陰影相對視窗的偏移，正 y 讓陰影往下沉，看起來更立體
        offset x=0 y=5
        // 🎨 設計優化：拿掉 teal 色調，改回純黑但保持輕透明度。
        // 桌布背景本身就是純黑，陰影用純黑反而更融入畫面、更沉穩，
        // 「打磨感」的沉穩黑不需要靠色彩，靠的是漸層柔和度（softness/spread）。
        color "#00000066"
    }

    // Struts shrink the area occupied by windows, similarly to layer-shell panels.
    // You can think of them as a kind of outer gaps. They are set in logical pixels.
    // Left and right struts will cause the next window to the side to always be visible.
    // Top and bottom struts will simply add outer gaps in addition to the area occupied by
    // layer-shell panels and regular gaps.
    // ⚠️ 這裡原本是負值 (-5)，代表視窗會往螢幕外多蓋 5px。
    // 如果不是刻意用來蓋掉某個殘留 gap/瑕疵，建議改回 0 或正值。
    struts {
        left 300
        right 80
        top -5
        bottom -5
    }
}


// 🆕 全域模糊效果（niri 26.04+）。
blur {
    // 取消註解以完全關閉（目前是「可用但需視窗/layer-rule 主動要求」的狀態）
    // off
    passes 3
    // 🎨 設計優化：offset 從 3 提高到 4，模糊更明顯一點，且 GPU 成本比加 passes 低
    offset 4
    // 🎨 設計優化：noise 從 0.02 提高到 0.05——你的桌布本身就是用網點/雜訊
    // 做出漸層的（halftone dither），刻意調高模糊的顆粒感等於呼應這個視覺語言，
    // 而不只是單純「消除色階斷層」的技術用途，這是有意義的設計連結。
    noise 0.05
    // 🎨 設計優化：從預設 1.5（提高飽和度）改成 0.5（降低飽和度）。
    // 預設值是替一般彩色桌面設計的，會讓模糊背景「更鮮豔」；但你的環境是
    // 刻意的無色彩系統，如果背景模糊時透出瀏覽器之類的彩色內容，飽和度
    // 拉低能讓它自動偏灰階，維持整體黑白調性的一致性，而不是被模糊放大色彩。
    saturation 0.5
}

environment {
  XMODIFIERS "@im=fcitx"
}

// Add lines like this to spawn processes at startup.
// Note that running niri as a session supports xdg-desktop-autostart,
// which may be more convenient to use.
spawn-at-startup "wlsunset"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "mako"
spawn-at-startup "udiskie"
spawn-sh-at-startup "sleep 2 && fcitx5 -rd"
spawn-at-startup "swayosd-server"
spawn-at-startup "awww-daemon"
spawn-at-startup "wl-paste" "--watch" "clapboard" "store"
spawn-at-startup "blur-wallpaper"
spawn-at-startup "elephant"
spawn-at-startup "walker" "--gapplication-service"
spawn-at-startup "codebase-memory-mcp" "daemon" "start"

cursor {
    // Change the theme and size of the cursor as well as set the
    // `XCURSOR_THEME` and `XCURSOR_SIZE` env variables.
    xcursor-theme "catppuccin-frappe-blue-cursors"
    xcursor-size 20
    hide-when-typing
    // 🎨 設計優化：閒置 3 秒後自動隱藏游標，適合盯著 log/terminal 輸出
    // 不太動滑鼠的工作型態，減少畫面上不必要的視覺干擾。
    hide-after-inactive-ms 3000
}

// 🆕 如果你有用中鍵貼上以外的剪貼簿管理工具，或不需要 X11 primary selection，
// 可以取消註解關閉，避免部分 app 的「選取即複製」行為造成困擾。
// clipboard {
//     disable-primary
// }

// Uncomment this line to ask the clients to omit their client-side decorations if possible.
// If the client will specifically ask for CSD, the request will be honored.
// Additionally, clients will be informed that they are tiled, removing some rounded corners.
prefer-no-csd

// You can change the path where screenshots are saved.
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
screenshot-path "~/Pictures/Screenshots/Niri %Y-%m-%d %H-%M-%S.png"

// You can also set this to null to disable saving screenshots to disk.
// screenshot-path null

// Settings for the "Important Hotkeys" overlay.
hotkey-overlay {
    // Uncomment this line if you don't want to see the hotkey help at niri startup.
    skip-at-startup
    // 🆕 只顯示「你有實際綁定」的動作，隱藏其他未綁定的預設項目，畫面更乾淨。
    hide-not-bound
}

// Animation settings.
animations {
    // Ucomment to turn off all animations.
    // off

    // Slow down all animations by this factor. Values below 1 speed them up instead.
    // slowdown 3.0

    window-close {
        duration-ms 200
        curve "linear"

        custom-shader r"
            // Example: make the window 'fall down' with slight rotation.
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                // For this shader, set animation curve to linear for best results.

                // Simulate an accelerated fall: square the (linear) progress.
                float progress = niri_clamped_progress * niri_clamped_progress;

                // Get our rotation pivot point coordinates at the bottom center of the window.
                vec2 coords = (coords_geo.xy - vec2(0.5, 1.0)) * size_geo.xy;

                // Move the window down to simulate a fall.
                coords.y -= progress * 200.0;

                // Randomize rotation direction and maximum angle.
                float random = (niri_random_seed - 0.5) / 2.0;
                random = sign(random) - random;
                float max_angle = 0.05 * random;

                // Rotate the window around our pivot point.
                float angle = progress * max_angle;
                mat2 rotate = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
                coords = rotate * coords;

                // Transform the coordinates back.
                coords_geo = vec3(coords / size_geo.xy + vec2(0.5, 1.0), 1.0);

                // Sample the window texture.
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);

                // Multiply by alpha to fade out.
                return color * (1.0 - niri_clamped_progress);
            }
        "
    }
}

window-rule {
  min-height 400
  min-width 420
  draw-border-with-background false
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

window-rule {
    match app-id="^think$"
    focus-ring {
        active-color "#a6e3a1"   // Green：自己思考
    }
    border {
        active-color "#a6e3a1"
    }
}

window-rule {
    match app-id="^pair$"
    focus-ring {
        active-color "#cba6f7"   // Mauve：AI 協作
    }
    border {
        active-color "#cba6f7"
    }
}

window-rule {
    match app-id="alacritty"
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="steam_app_*"
    open-fullscreen true
}

window-rule {
    match app-id="org.gnome.Characters"
    default-column-width { proportion 0.4; }
}

// --- 寬版工具（1425px）：需要較多水平空間的參考/創作型應用 ---
window-rule {
    match app-id="PacketTracer"
    match app-id="[Ss]potify"
    match app-id="[Ss]onora"
    match app-id="solaar"
    match app-id="firefox"
    match app-id="obsidian"
    match app-id="zen"
    match app-id="rustdesk"
    match app-id="sniffnet"
    match app-id="^figma.*$"
    match app-id="anytype"
    match app-id="io.github.kukuruzka165.materialgram"
    match app-id="neovide"
    match app-id="^think$"
    match app-id="^pair$"
    default-column-width { fixed 1425; }
    draw-border-with-background true
}


// --- 中等工具（1256px）：檔案總管、聊天、編輯器等一般工作視窗 ---
window-rule {
    match app-id="org.gnome.Nautilus"
    match app-id="vesktop"
    match app-id="dev.zed.Zed"
    match app-id="Waydroid"
    match app-id="bottles"
    default-column-width { fixed 1256; }
}

window-rule {
    match app-id="vlc"
    default-column-width { fixed 920; }
}


// Floating window-rules

// 🎨 設計優化：「霧面玻璃」質感——淡淡透明 + 背景模糊 + 顆粒感，
// 呼應桌布的網點紋理，讓打磨感是視覺上說得通的，不是隨便加的效果。
//
// 刻意只套用在 Spotify / 聊天軟體這類「用看的、不用長時間盯字」的視窗。
// alacritty / Obsidian / Firefox / Zed / Nautilus 這些你會盯著看大量文字
// 的工作視窗完全沒動——niri 的 opacity 是整個視窗（含文字）一起變淡，
// 套在那些視窗上會犧牲清晰度，不值得為了美感犧牲生產力。
//
// 如果你想要終端機「看起來」有透明背景又保持文字銳利，建議直接在
// alacritty.toml 設定它原生的 background_opacity——那是只淡化背景色塊、
// 文字維持完全不透明的做法，效果比這裡的 compositor 層級模糊好很多。
window-rule {
    match app-id="[Ss]onora"
    match app-id="[Ss]potify"
    match app-id="io.github.kukuruzka165.materialgram"
    match app-id="vesktop"
    opacity 0.92
    background-effect {
        blur true
    }
}


window-rule {
    match title="Open Folder"
    open-floating true
}

window-rule {
    match app-id="zenity"
    open-floating true
    // 🎨 設計優化：系統對話框加背景模糊，明確傳達「這是暫時疊在上層、
    // 需要你回應的視窗」，是常見的 modal/dialog 設計手法。
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="XEyes"
    open-floating true
}

window-rule {
    match title="Friends List" app-id="steam"
    open-floating true
}

window-rule {
    match app-id="gcr-prompter"
    open-floating true
    background-effect {
        blur true
    }
}

window-rule {
    match title="vesktop" app-id="vesktop"
    open-floating true
}

window-rule {
    match title="^.{0}$"
    open-floating true
}

window-rule {
    match app-id="Vesktop"
    open-floating true
}

window-rule {
    match app-id="imv"
    open-floating true
}

// 🆕 螢幕分享/錄影時自動遮蔽密碼管理器等敏感視窗。
// 把下面的 app-id 換成你實際用的密碼管理器（例如 KeePassXC、Bitwarden 等），
// 目前先用範例值註解掉，確認 app-id 後取消 /- 前綴即可啟用。
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

// 🎨 設計優化：walker（Mod+D 開啟的 app launcher）通常是用 layer-shell
// 實作的懸浮面板，加上背景模糊能做出類似 macOS Spotlight 的漂浮質感。
// namespace 是我根據 walker 常見命名猜的，如果沒作用，用
// `niri msg layers` 在 walker 開啟時查實際 namespace 再改這裡即可
// （沒對到也不會報錯，只是不會生效，改壞了也安全）。
layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
    }
}

// 🎨 設計優化：你的 waybar 本身是黑白色系，加上背景模糊能讓它有「懸浮」
// 在桌面上方的層次感，而不是死板貼在螢幕邊緣的一條色塊。
// waybar 預設的 layer-shell namespace 就是 "waybar"，這個不用像 walker 那樣猜。
layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur true
    }
}


// 🎨 設計優化：backdrop-color 跟 workspace-shadow 原本都沒設，代表切到總覽
// 模式時用的是 niri 預設灰黑背景跟預設陰影，跟你平常畫面的色調/陰影對不起來，
// 會有「模式切換時風格斷裂」的感覺。這裡讓總覽的視覺語言跟平常畫面一致。
overview {
    zoom 0.55
    // 🎨 改成接近純黑，貼合桌布本身的黑色背景，而不是帶色調的深藍
    backdrop-color "#0A0A0A"
    workspace-shadow {
        // workspace 卡片是整個畫面縮小顯示，陰影參數要比一般視窗陰影大得多
        // 才看得出立體感
        softness 40
        spread 10
        offset x=0 y=10
        color "#00000060"
    }
}


binds {
    // Keys consist of modifiers separated by + signs, followed by an XKB key name
    // in the end. To find an XKB name for a particular key, you may use a program
    // like wev.
    //
    // "Mod" is a special modifier equal to Super when running on a TTY, and to Alt
    // when running as a winit window.
    //
    // Most actions that you can bind here can also be invoked programmatically with
    // `niri msg action do-something`.

    // Mod-Shift-/, which is usually the same as Mod-?,
    // shows a list of important hotkeys.
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Suggested binds for running programs: terminal, app launcher, screen locker.
    Mod+Return { spawn "alacritty"; }
    Mod+D { spawn "walker"; }
    Mod+X { spawn "wlogout"; }

    Mod+Space { toggle-overview; }

    // Check https://cgit.freedesktop.org/xorg/proto/x11proto/tree/XF86keysym.h
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    Mod+XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SOURCE@" "0.1+"; }
    Mod+XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SOURCE@" "0.1-"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }

    Mod+Q { close-window; }

    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+H { move-window-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-window-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-window-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-window-to-monitor-right; }

    Mod+H          { focus-column-left; }
    Mod+J          { focus-window-or-workspace-down; }
    Mod+K          { focus-window-or-workspace-up; }
    Mod+L          { focus-column-right; }
    Mod+Home       { focus-column-first; }
    Mod+End        { focus-column-last; }

    Mod+Shift+H    { move-column-left; }
    Mod+Shift+J    { move-window-down-or-to-workspace-down; }
    Mod+Shift+K    { move-window-up-or-to-workspace-up; }
    Mod+Shift+L    { move-column-right; }

    Mod+I       { focus-workspace-down; }

    Mod+Shift+C { spawn "sh" "-c" "env DISPLAY=:0 xsel -ob | wl-copy"; }
    Mod+Shift+V { spawn "sh" "-c" "wl-paste -n | env DISPLAY=:0 xsel -ib"; }

    Mod+O       { focus-workspace-up; }
    Mod+Shift+I { move-workspace-down; }
    Mod+Shift+O { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+TouchpadScrollUp         { focus-workspace-up; }
    Mod+TouchpadScrollDown       { focus-workspace-down; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // 🆕 把游標右邊的視窗吸進目前欄位的最下面 / 把目前欄位最下面的視窗吐出去右邊。
    // 跟上面的 consume-or-expel-window-left/right 是互補功能，用來精細調整同一欄裡有幾個視窗。
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    // 🆕 反向循環 preset-column-widths，跟 Mod+R 互補。
    // 你原本 Mod+Shift+R 綁的是 reset-window-height，這裡改放到 Mod+Ctrl+Shift+R，
    // 並保留 reset-window-height 在原本按鍵，兩個功能都留著、不互相覆蓋。
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { reset-window-height; }

    Mod+M { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+C { center-column; }
    // 🆕 把畫面上所有「完全可見」的欄位置中，跟 center-column 是不同層級的置中。
    Mod+Ctrl+C { center-visible-columns; }

    // 🆕 展開目前欄位，填滿其他完整可見欄位之外剩下的空間。
    Mod+Ctrl+F { expand-column-to-available-width; }

    // 🆕 讓目前視窗在「浮動」與「平鋪」兩種模式間切換，適合小工具視窗、對話框。
    Mod+V { toggle-window-floating; }
    // 🆕 在浮動視窗與平鋪視窗之間切換焦點，不改變任何視窗的模式。
    // 原本 Mod+Shift+V 已經被你拿去做 X11↔Wayland 剪貼簿同步了，改綁這裡避免撞鍵。
    Mod+Ctrl+V { switch-focus-between-floating-and-tiling; }

    // 🆕 把目前欄位切換成「分頁模式」：欄位內多個視窗會疊在一起、用分頁切換，
    // 適合同時開很多終端機或編輯器又想省畫面空間的情境。
    Mod+W { toggle-column-tabbed-display; }

    // Finer width adjustments.
    // This command can also:
    // * set width in pixels: "1000"
    // * adjust width in pixels: "-5" or "+5"
    // * set width as a percentage of screen width: "25%"
    // * adjust width as a percentage of screen width: "-10%" or "+10%"
    // Pixel sizes use logical, or scaled, pixels. I.e. on an output with scale 2.0,
    // set-column-width "100" will make the column occupy 200 physical screen pixels.
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Finer height adjustments when in column with other windows.
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Actions to switch layouts.
    // Note: if you uncomment these, make sure you do NOT have
    // a matching layout switch hotkey configured in xkb options above.
    // Having both at once on the same hotkey will break the switching,
    // since it will switch twice upon pressing the hotkey (once by xkb, once by niri).
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // 讓遠端桌面/軟體 KVM 等程式可以要求 niri 暫停處理快捷鍵，
    // 把按鍵原封不動轉發給遠端機器。allow-inhibiting=false 確保這個逃生鍵
    // 永遠有效，就算某個程式卡住了 inhibitor 也切得掉。
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // 🆕 一鍵關閉所有螢幕省電，移動滑鼠或按任意鍵即可喚醒。
    Mod+Shift+P { power-off-monitors; }

    // The quit action will show a confirmation dialog to avoid accidental exits.
    // If you want to skip the confirmation dialog, set the flag like so:
    // Mod+Shift+E { quit skip-confirmation=true; }
    Mod+Shift+E { quit; }
}

debug {
    wait-for-frame-completion-before-queueing
}
